# ==============================================================================
# ROOT .env — read by Docker Compose only
# ==============================================================================
#
# Two different .env files, two different jobs:
#
#   .env          (this file, repo root)  -> substitutes ${...} in docker-compose.yml
#   backend/.env                          -> configures the application itself
#
# Compose only ever reads the root one. The backend service loads backend/.env
# via `env_file:`, so API keys and thresholds stay where they already are.
#
# Setup:
#   cp .env.example .env
#   # then set QDRANT_API_KEY below
#   docker compose up -d

# ------------------------------------------------------------------------------
# REQUIRED — compose refuses to start without it
# ------------------------------------------------------------------------------
# Qdrant ships with NO authentication. Even bound to loopback, an unauthenticated
# instance is a full read/write database one SSH tunnel or misconfigured firewall
# rule away from being public. Generate one:
#
#   openssl rand -hex 32
#
# The same value must appear in backend/.env as QDRANT_API_KEY so the app can
# authenticate against it.
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL — these fall back to the defaults in docker-compose.yml, and are
# normally set in backend/.env instead. Listed here only for one-off overrides,
# e.g. flipping providers without editing backend/.env.
# ------------------------------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.1-8b-instant
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# MIN_RETRIEVAL_SCORE=0.80
# MAX_TOKENS=48
# ADMIN_TOKEN=
# CORS_ORIGINS=*
