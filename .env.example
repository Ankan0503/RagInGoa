# ==============================================================================
# ROOT .env — read by Docker Compose only
# ==============================================================================
#
# Two different .env files, two different jobs:
#
#   .env          (this file, repo root)  -> substitutes ${...} in docker-compose.yml
#   backend/.env                          -> configures the application itself
#
# Compose only ever reads the root one. The backend service loads backend/.env
# via `env_file:`, so API keys and thresholds stay where they already are.
#
# Setup:
#   cp .env.example .env
#   # then set QDRANT_API_KEY below
#   docker compose up -d

# ------------------------------------------------------------------------------
# REQUIRED — compose refuses to start without it
# ------------------------------------------------------------------------------
# Qdrant ships with NO authentication. Even bound to loopback, an unauthenticated
# instance is a full read/write database one SSH tunnel or misconfigured firewall
# rule away from being public. Generate one:
#
#   openssl rand -hex 32
#
# The same value must appear in backend/.env as QDRANT_API_KEY so the app can
# authenticate against it.
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# REQUIRED ON DOKPLOY — leave unset for plain `docker compose up`
# ------------------------------------------------------------------------------
# Where parents.sqlite and index_manifest.json live on the HOST. These are
# gitignored (parents.sqlite is 281MB) so they are never in the git clone, and
# Dokploy replaces that clone on every deploy.
#
#   plain docker compose : leave unset -> defaults to ./backend
#   Dokploy              : INDEX_DIR=../files
#
# Verify the resolved host path in Dokploy under Advanced > Volumes before the
# first deploy. If the path is wrong Docker creates a DIRECTORY where a file was
# expected, and the app fails in a confusing way rather than a clear one.
# INDEX_DIR=../files

# ------------------------------------------------------------------------------
# OPTIONAL — these fall back to the defaults in docker-compose.yml, and are
# normally set in backend/.env instead. Listed here only for one-off overrides,
# e.g. flipping providers without editing backend/.env.
# ------------------------------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_MODEL=llama-3.1-8b-instant
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# MIN_RETRIEVAL_SCORE=0.850   # calibrated 2026-08-19 against the live index
# MIN_SCORE_MARGIN=0.0        # 0.0 = disabled. Calibrate before raising —
#                              # see calibrate_threshold.py
# STRATEGY_FLOOR_DELTA=window=-0.07,semantic=-0.05,passage=-0.03
#                              # per-strategy corrections to the floor above.
#                              # Pinning a chunking strategy filters the search
#                              # to one chunk type, which lowers every score, so
#                              # one absolute floor answers a question under one
#                              # dropdown setting and refuses it under another.
#                              # Re-measure: python diagnose_gates.py --strategies
# MIN_NOVEL_GROUNDING=0.5     # fraction of the answer's non-question words that
#                              # must appear in the retrieved context. Words an
#                              # answer shares with its question are guaranteed
#                              # hits and prove nothing. 0 disables the check.
# SPARSE_RESCUE_DELTA=0.02    # how far below the floor a query may still be
#                              # answered when dense and BM25 independently rank
#                              # the same passage first. 0 disables the rescue.
#                              # Re-measure: python diagnose_gates.py --rescue
# MAX_TOKENS=128              # below ~96 gpt-oss reasoning eats the whole budget
#                              # and every answer comes back empty
# ADMIN_TOKEN=
# CORS_ORIGINS=*
